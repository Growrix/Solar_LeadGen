{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Gate0: Typecheck",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"-p",
				"tsconfig.gate.json",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Gate0: Prisma validate",
			"type": "shell",
			"command": "npx",
			"args": [
				"prisma",
				"validate"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Gate0: Next build",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"if (Test-Path .next) { Remove-Item -Recurse -Force .next }; npm run build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}