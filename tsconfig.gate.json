{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "prisma/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backup",
    "backup/**",
    "backup-*",
    "test-results",
    "playwright-report",
    "test-*.ts",
    "check-*.ts",
    "migrate-*.ts"
  ]
}
