generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model GuestInstantQuote {
  id                    String    @id @default(cuid())
  sessionId             String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  quoteType             String
  postcode              String
  location              String
  state                 String
  electricityUsageType  String
  roofType              String
  budgetRange           String
  panelOrientation      String
  roofTilt              String
  shadingLevel          String
  desiredOffset         Int
  usagePattern          String?
  batteryIncluded       Boolean   @default(false)
  batteryCapacity       String?
  batteryBrand          String?
  batteryUsage          String?
  includeVPP            Boolean   @default(false)
  peakDemand            String?
  isThreePhase          Boolean   @default(false)
  projectPriority       String?
  retailer              String?
  tariffPlan            String?
  customRetailRate      String?
  customFeedInRate      String?
  panelBrand            String?
  includeOptimizers     Boolean   @default(false)
  includeMicroinverters Boolean   @default(false)
  includeEVCharging     Boolean   @default(false)
  includeSmartHome      Boolean   @default(false)
  includeGridServices   Boolean   @default(false)
  hasExistingSystem     Boolean   @default(false)
  existingSystemSize    String?
  systemSizeOverride    String?
  results               Json
  adminNotes            String?
  isConverted           Boolean   @default(false)
  conversionDate        DateTime?
  electricityValue      Float
  additionalArrays      Json?
  backupCritical        String?
  customBatteryCapacity String?

  @@index([createdAt])
  @@index([state])
  @@index([quoteType])
  @@index([sessionId])
  @@map("guest_instant_quotes")
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  emailVerified            DateTime?
  role                     UserRole                 @default(HOMEOWNER)
  isActive                 Boolean                  @default(true)
  name                     String?
  phone                    String?
  image                    String?
  companyName              String?
  businessAddress          String?
  postcode                 String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  lastLoginAt              DateTime?
  installerVerified        Boolean                  @default(false)
  leadSubmissionCount      Int                      @default(0)
  phoneVerified            Boolean                  @default(false)
  leadSubmissionLimit      Int                      @default(5)
  biddingLeadsSubmitted    Int                      @default(0)
  emailVerifiedAt          DateTime?
  lastLoginIp              String?
  password                 String?
  profileComplete          Boolean                  @default(false)
  sessionVersion           Int                      @default(0)
  signupIp                 String?
  signupUserAgent          String?
  biddingLeadsLimit        Int                      @default(1)
  accounts                 Account[]
  bidsAsInstaller          Bid[]                    @relation("installer_bids")
  blogPosts                BlogPost[]
  blogAiRequestLogs         BlogAiRequestLog[]
  newsAiRequestLogs         NewsAiRequestLog[]     @relation("news_ai_actor")
  newsItemsCreated         NewsItem[]               @relation("news_item_created_by")
  newsItemsOgImageApproved  NewsItem[]              @relation("news_item_og_image_approved_by")
  newsAuditLogs            NewsAuditLog[]           @relation("news_audit_actor")
  verificationTokens       EmailVerificationToken[]
  installerPreferences     InstallerPreferences?
  installerProfile         InstallerProfile?
  installerVerification    InstallerVerification?
  adminAssignments         LeadAssignment[]         @relation("admin_assignments")
  installerAssignments     LeadAssignment[]         @relation("installer_assignments")
  leadsAsHomeowner         Lead[]                   @relation("homeowner_leads")
  leadsAsInstaller         Lead[]                   @relation("installer_leads")
  passwordResetTokens      PasswordResetToken[]
  phoneVerifications       PhoneVerification[]
  quotesAsInstaller        Quote[]                  @relation("installer_quotes")
  sessions                 Session[]
  writtenQuotesAsInstaller WrittenQuote[]           @relation("installer_written_quotes")

  @@index([email])
  @@index([role])
  @@map("users")
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogJobType {
  PUBLISH_SCHEDULED
  N8N_CREATE_DRAFT
  N8N_SCHEDULE_POST
}

enum BlogJobStatus {
  SUCCESS
  FAILURE
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("blog_categories")
}

model BlogTag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  posts     BlogPostTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("blog_tags")
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String         @default("")
  content        String         @default("")
  coverImageUrl  String         @default("")
  readTime       String         @default("")
  status         BlogPostStatus @default(DRAFT)
  robots         String         @default("index,follow")
  seoTitle       String         @default("")
  seoDescription String         @default("")
  ogImageUrl     String         @default("")
  canonicalUrl   String         @default("")
  scheduledFor   DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  authorId       String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           BlogPostTag[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledFor])
  @@index([authorId])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogAiRequestLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  input     Json
  output    Json?
  success   Boolean  @default(false)
  error     String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("blog_ai_request_logs")
}

model BlogJobLog {
  id         String       @id @default(cuid())
  type       BlogJobType
  status     BlogJobStatus
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  meta       Json?
  error      String?

  @@index([startedAt])
  @@index([type])
  @@index([status])
  @@map("blog_job_logs")
}

enum NewsItemStatus {
  DRAFT
  NEEDS_REVIEW
  RESEARCH_DONE
  DRAFT_READY
  PUBLISHED
  SCHEDULED
  REJECTED
  ERROR
}

enum NewsSourceKind {
  RSS_FEED
}

enum NewsResearchKind {
  WEB
  SOCIAL
  JOURNAL
  TREND
}

enum NewsSourceEntryStatus {
  NEW
  PROCESSED
  IGNORED
  ERROR
}

enum NewsJobType {
  RSS_SYNC
  RESEARCH_SYNC
  AI_DRAFT
  AI_REGENERATE
  AUTO_RUN
  AUTO_SCHEDULE
  AUTO_PUBLISH
  DEDUP_CLEANUP
}

enum NewsJobStatus {
  SUCCESS
  FAILURE
}

enum NewsItemSourceType {
  RSS_FEED
  AI_AGENT
  MANUAL_ENTRY
}

enum NewsAiTaskType {
  research_deep
  research_fast
  draft_longform
  rewrite
  seo
  dedup_semantic
  image_prompt
  image_generate
}

enum NewsApiKeyPool {
  RESEARCH
  DRAFTING
  IMAGES
}

model NewsModelProfile {
  id               String   @id @default(cuid())
  displayName      String
  provider         String
  modelId          String
  useCaseTags      String[]
  costTier         String   @default("")
  jsonModeRequired Boolean  @default(false)
  maxTokens        Int?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  routerDefaults   NewsModelRouterDefault[]
  aiRequestLogs    NewsAiRequestLog[]

  @@index([enabled])
  @@index([createdAt])
  @@map("news_model_profiles")
}

model NewsModelRouterDefault {
  taskType       NewsAiTaskType @unique
  modelProfileId String
  modelProfile   NewsModelProfile @relation(fields: [modelProfileId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("news_model_router_defaults")
}

model NewsApiKey {
  id            String        @id @default(cuid())
  provider      String
  label         String
  pools         NewsApiKeyPool[]
  enabled       Boolean       @default(true)
  encryptedKey  String

  lastUsedAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  aiRequestLogs NewsAiRequestLog[]

  @@index([enabled])
  @@index([provider])
  @@index([createdAt])
  @@map("news_api_keys")
}

model NewsSource {
  id           String     @id @default(cuid())
  name         String
  url          String
  kind         NewsSourceKind @default(RSS_FEED)
  enabled      Boolean    @default(true)
  lastSync     DateTime?
  articleCount Int        @default(0)

  etag               String?
  lastModified       String?
  lastFetchedAt      DateTime?
  lastError          String?
  errorCount         Int        @default(0)
  fetchIntervalMinutes Int      @default(60)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        NewsItem[]
  entries      NewsSourceEntry[]
  auditLogs    NewsAuditLog[]

  @@index([enabled])
  @@index([createdAt])
  @@map("news_sources")
}

model NewsSourceEntry {
  id            String               @id @default(cuid())
  sourceId      String
  source        NewsSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  externalId    String?
  url           String
  title         String
  publishedAt   DateTime?
  fetchedAt     DateTime             @default(now())

  status        NewsSourceEntryStatus @default(NEW)
  error         String?
  rawJson       Json?

  itemId        String?
  item          NewsItem?            @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([sourceId, url])
  @@index([status])
  @@index([publishedAt])
  @@index([fetchedAt])
  @@map("news_source_entries")
}

model NewsResearchEntry {
  id            String               @id @default(cuid())
  kind          NewsResearchKind
  query         String?

  url           String
  title         String
  publishedAt   DateTime?
  fetchedAt     DateTime             @default(now())

  status        NewsSourceEntryStatus @default(NEW)
  error         String?
  rawJson       Json?

  itemId        String?
  item          NewsItem?            @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([kind, url])
  @@index([kind])
  @@index([status])
  @@index([publishedAt])
  @@index([fetchedAt])
  @@map("news_research_entries")
}

model NewsItem {
  id              String            @id @default(cuid())
  title           String
  summary         String            @default("")
  contentHtml     String            @default("")
  status          NewsItemStatus    @default(DRAFT)
  category        String            @default("")
  relevanceScore  Int               @default(0)
  aiModel         String            @default("")
  sourceType      NewsItemSourceType @default(MANUAL_ENTRY)
  sourceId        String?
  source          NewsSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?             @relation("news_item_created_by", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  publishedAt     DateTime?
  scheduledFor    DateTime?

  schedulePriority String           @default("Normal")
  scheduleExpiresAt DateTime?
  scheduleIsFeatured Boolean        @default(false)

  rejectedAt      DateTime?
  rejectionReason String?
  slug            String?           @unique
  tags            String[]
  deletedAt       DateTime?

  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?

  ogImageLastCheckedAt   DateTime?
  ogImageLastCheckStatus String?
  ogImageLastCheckError  String?

  ogImageApprovalRequired Boolean   @default(true)
  ogImageApprovedAt       DateTime?
  ogImageApprovedById     String?
  ogImageApprovedBy       User?     @relation("news_item_og_image_approved_by", fields: [ogImageApprovedById], references: [id], onDelete: SetNull)

  auditLogs       NewsAuditLog[]
  sourceEntries   NewsSourceEntry[]
  researchEntries NewsResearchEntry[]
  aiRequestLogs   NewsAiRequestLog[]

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledFor])
  @@index([deletedAt])
  @@index([sourceId])
  @@index([createdById])
  @@map("news_items")
}

model NewsAiRequestLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("news_ai_actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String

  itemId    String?
  item      NewsItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  provider  String
  model     String
  taskType  NewsAiTaskType?
  modelProfileId String?
  modelProfile   NewsModelProfile? @relation(fields: [modelProfileId], references: [id], onDelete: SetNull)
  apiKeyId       String?
  apiKey         NewsApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  durationMs     Int?
  input     Json
  output    Json?
  success   Boolean  @default(false)
  error     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([itemId])
  @@index([taskType])
  @@index([modelProfileId])
  @@index([apiKeyId])
  @@map("news_ai_request_logs")
}

model NewsJobLog {
  id         String       @id @default(cuid())
  type       NewsJobType
  status     NewsJobStatus
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  meta       Json?
  error      String?

  @@index([startedAt])
  @@index([type])
  @@index([status])
  @@map("news_job_logs")
}

model NewsAutomationRule {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("news_automation_rules")
}

model NewsAuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  actor     User?    @relation("news_audit_actor", fields: [actorId], references: [id], onDelete: SetNull)
  itemId    String?
  item      NewsItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sourceId  String?
  source    NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  metadata  Json?
  promptUsed String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([itemId])
  @@index([sourceId])
  @@index([createdAt])
  @@map("news_audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lead {
  id                    String            @id @default(cuid())
  homeownerId           String
  installerId           String?
  status                LeadStatus        @default(DRAFT)
  visibility            LeadVisibility    @default(HIDDEN)
  phoneVerified         Boolean           @default(false)
  phoneNumber           String?
  projectType           String
  propertyType          String
  postcode              String
  location              String
  state                 String
  address               String?
  energyBill            Float
  billType              String
  roofType              String
  budgetRange           String
  desiredOffset         Int
  batteryRequired       Boolean           @default(false)
  batteryCapacity       String?
  timeframe             String?
  additionalNotes       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  approvedAt            DateTime?
  purchasedAt           DateTime?
  expiresAt             DateTime?
  initialCountdownDays  Int?
  adminNotes            String?
  flaggedReason         String?
  moderatedBy           String?
  moderatedAt           DateTime?
  leadPrice             Float?
  purchaseStatus        PurchaseStatus?
  stripePaymentIntentId String?
  quoteData             Json?
  quoteType             LeadQuoteType     @default(CALL_VISIT)
  archivedAt            DateTime?
  assignedAt            DateTime?
  assignedBy            String?
  assignmentNotes       String?
  cancelledAt           DateTime?
  cancelledBy           String?
  cancelledReason       String?
  name                  String?
  auditLogs             AuditLog[]
  bids                  Bid[]
  chatMessages          ChatMessage[]
  documents             InstallDocument[]
  assignments           LeadAssignment[]  @relation("lead_assignments")
  feedback              LeadFeedback?
  homeowner             User              @relation("homeowner_leads", fields: [homeownerId], references: [id], onDelete: Cascade)
  installer             User?             @relation("installer_leads", fields: [installerId], references: [id])
  quotes                Quote[]
  writtenQuotes         WrittenQuote[]

  @@index([homeownerId])
  @@index([installerId])
  @@index([status])
  @@index([visibility])
  @@index([quoteType])
  @@index([postcode])
  @@index([state])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("leads")
}

model LeadAssignment {
  id          String   @id @default(cuid())
  leadId      String
  installerId String
  assignedBy  String
  assignedAt  DateTime @default(now())
  notes       String?
  notified    Boolean  @default(false)
  admin       User     @relation("admin_assignments", fields: [assignedBy], references: [id])
  installer   User     @relation("installer_assignments", fields: [installerId], references: [id], onDelete: Cascade)
  lead        Lead     @relation("lead_assignments", fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, installerId])
  @@index([leadId])
  @@index([installerId])
  @@index([assignedBy])
  @@map("lead_assignments")
}

model PhoneVerification {
  id              String    @id @default(cuid())
  phoneNumber     String
  verificationSid String?
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  code            String
  status          String    @default("PENDING")
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([userId])
  @@index([status])
  @@map("phone_verifications")
}

model InstallDocument {
  id           String   @id @default(cuid())
  leadId       String
  documentType String
  fileName     String
  fileSize     Int
  contentType  String
  s3Key        String
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("install_documents")
}

model ChatMessage {
  id         String    @id @default(cuid())
  leadId     String
  senderId   String
  senderRole UserRole
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Quote {
  id               String    @id @default(cuid())
  leadId           String
  installerId      String
  quoteType        QuoteType
  systemSize       Float
  panelBrand       String?
  inverterBrand    String?
  batteryBrand     String?
  batteryCapacity  Float?
  totalPrice       Float
  federalRebate    Float?
  stateRebate      Float?
  finalPrice       Float
  description      String?
  paybackYears     Float?
  annualSavings    Float?
  warranty         String?
  installTimeline  String?
  attachmentS3Keys String[]
  status           String    @default("pending")
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  installer        User      @relation("installer_quotes", fields: [installerId], references: [id], onDelete: Cascade)
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([installerId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model Bid {
  id                  String    @id @default(cuid())
  leadId              String
  installerId         String
  amount              Float
  capacityOffer       Float?
  expectedInstallDate DateTime?
  notes               String?
  panelBrand          String?
  inverterBrand       String?
  batteryBrand        String?
  batteryCapacity     String?
  includeGst          Boolean   @default(true)
  gstPercent          Float     @default(10.0)
  gstAmount           Float     @default(0)
  includeIncentive    Boolean   @default(false)
  incentiveAmount     Float     @default(0)
  finalTotal          Float
  status              String    @default("SUBMITTED")
  selectedAt          DateTime?
  purchasedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  systemData          Json?
  productsData        Json?
  lineItems           Json?
  assumptions         Json?
  roofData            Json?
  calculations        Json?
  importMeta          Json?
  installerContact    Json?
  installer           User      @relation("installer_bids", fields: [installerId], references: [id], onDelete: Cascade)
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, installerId])
  @@index([leadId])
  @@index([installerId])
  @@index([status])
  @@index([createdAt])
  @@map("bids")
}

model WrittenQuote {
  id                  String    @id @default(cuid())
  leadId              String
  installerId         String
  amount              Float
  capacityOffer       Float?
  expectedInstallDate DateTime?
  notes               String?
  panelBrand          String?
  inverterBrand       String?
  batteryBrand        String?
  batteryCapacity     String?
  includeGst          Boolean   @default(true)
  gstPercent          Float     @default(10.0)
  gstAmount           Float     @default(0)
  includeIncentive    Boolean   @default(false)
  incentiveAmount     Float     @default(0)
  finalTotal          Float
  status              String    @default("SUBMITTED")

  // Negotiation-specific fields (7 new fields)
  negotiationStatus      String    @default("PENDING")
  homeownerCounterAmount Float?
  homeownerCounterAt     DateTime?
  installerRevisedAmount Float?
  installerRevisedAt     DateTime?
  agreedAmount           Float?
  agreedAt               DateTime?
  agreedBy               String?

  // Negotiation limits
  homeownerCounterCount  Int @default(0)
  installerRevisionCount Int @default(0)
  negotiationTurnCount   Int @default(0)

  // Negotiation time window + presence (Phase 13W.4)
  negotiationDeadlineAt  DateTime?
  negotiationExpiredAt   DateTime?
  homeownerModalActiveAt DateTime?
  installerModalActiveAt DateTime?
  homeownerExtensionUsed Boolean   @default(false)
  installerExtensionUsed Boolean   @default(false)
  adminExtensionCount    Int       @default(0)
  adminLastExtendedAt    DateTime?
  adminLastExtendedBy    String?

  selectedAt      DateTime?
  purchasedAt     DateTime?
  rejectedAt      DateTime?
  rejectedByRole  UserRole?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Phase 13W - Comprehensive Quote Builder data (JSON fields)
  systemData       Json? // System capacity, type, solar panels array
  productsData     Json? // Panel, inverter, battery details with brands/models
  lineItems        Json? // Pricing engine 9 categories with itemized breakdown
  assumptions      Json? // Feed-in tariff, usage, offset, payback assumptions
  roofData         Json? // Roof type, pitch, arrays, orientations, shading, site details
  calculations     Json? // Total cost, GST, incentive, final total, payback calculations
  importMeta       Json? // Prefilled fields, import source, import timestamp
  installerContact Json? // Installer name, email, phone for homeowner to contact

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  installer User @relation("installer_written_quotes", fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([leadId, installerId])
  @@index([leadId])
  @@index([installerId])
  @@index([negotiationStatus])
  @@index([negotiationDeadlineAt])
  @@index([status])
  @@index([createdAt])
  @@map("written_quotes")
}

