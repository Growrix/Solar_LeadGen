generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model GuestInstantQuote {
  id                    String    @id @default(cuid())
  sessionId             String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  quoteType             String
  postcode              String
  location              String
  state                 String
  electricityUsageType  String
  roofType              String
  budgetRange           String
  panelOrientation      String
  roofTilt              String
  shadingLevel          String
  desiredOffset         Int
  usagePattern          String?
  batteryIncluded       Boolean   @default(false)
  batteryCapacity       String?
  batteryBrand          String?
  batteryUsage          String?
  includeVPP            Boolean   @default(false)
  peakDemand            String?
  isThreePhase          Boolean   @default(false)
  projectPriority       String?
  retailer              String?
  tariffPlan            String?
  customRetailRate      String?
  customFeedInRate      String?
  panelBrand            String?
  includeOptimizers     Boolean   @default(false)
  includeMicroinverters Boolean   @default(false)
  includeEVCharging     Boolean   @default(false)
  includeSmartHome      Boolean   @default(false)
  includeGridServices   Boolean   @default(false)
  hasExistingSystem     Boolean   @default(false)
  existingSystemSize    String?
  systemSizeOverride    String?
  results               Json
  adminNotes            String?
  isConverted           Boolean   @default(false)
  conversionDate        DateTime?
  electricityValue      Float
  additionalArrays      Json?
  backupCritical        String?
  customBatteryCapacity String?

  @@index([createdAt])
  @@index([state])
  @@index([quoteType])
  @@index([sessionId])
  @@map("guest_instant_quotes")
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  emailVerified         DateTime?
  emailVerifiedAt       DateTime? // Auth Part A+B: track verification timestamp
  password              String?
  role                  UserRole                 @default(HOMEOWNER)
  isActive              Boolean                  @default(true)
  name                  String?
  phone                 String?
  image                 String?
  companyName           String?
  businessAddress       String?
  postcode              String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  lastLoginAt           DateTime?
  installerVerified     Boolean                  @default(false)
  leadSubmissionCount   Int                      @default(0)
  phoneVerified         Boolean                  @default(false)
  leadSubmissionLimit   Int                      @default(5)
  biddingLeadsSubmitted Int                      @default(0)
  profileComplete       Boolean                  @default(false) // Auth Part A+B: installer onboarding gate
  sessionVersion        Int                      @default(0) // Auth Part A+B: invalidate sessions on password reset
  signupIp              String? // Phase 21: IP address captured at registration
  signupUserAgent       String? // Phase 21: Browser/device info at registration
  lastLoginIp           String? // Phase 21: Most recent login IP (future use)
  accounts              Account[]
  leadsAsHomeowner      Lead[]                   @relation("homeowner_leads")
  leadsAsInstaller      Lead[]                   @relation("installer_leads")
  phoneVerifications    PhoneVerification[]
  quotesAsInstaller     Quote[]                  @relation("installer_quotes")
  bidsAsInstaller       Bid[]                    @relation("installer_bids")
  sessions              Session[]
  installerAssignments  LeadAssignment[]         @relation("installer_assignments")
  adminAssignments      LeadAssignment[]         @relation("admin_assignments")
  installerProfile      InstallerProfile? // Auth Part A+B: installer onboarding data
  verificationTokens    EmailVerificationToken[] // Auth Part A+B: email verification
  passwordResetTokens   PasswordResetToken[] // Auth Part A+B: password reset
  installerVerification InstallerVerification?
  installerPreferences  InstallerPreferences?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lead {
  id                    String            @id @default(cuid())
  homeownerId           String
  installerId           String?
  status                LeadStatus        @default(DRAFT)
  visibility            LeadVisibility    @default(HIDDEN)
  phoneVerified         Boolean           @default(false)
  phoneNumber           String?
  name                  String? // Phase 12: Homeowner name for contact purposes
  projectType           String
  propertyType          String
  postcode              String
  location              String
  state                 String
  address               String?
  energyBill            Float
  billType              String
  roofType              String
  budgetRange           String
  desiredOffset         Int
  batteryRequired       Boolean           @default(false)
  batteryCapacity       String?
  timeframe             String?
  additionalNotes       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  approvedAt            DateTime?
  purchasedAt           DateTime?
  expiresAt             DateTime?
  adminNotes            String?
  flaggedReason         String?
  moderatedBy           String?
  moderatedAt           DateTime?
  leadPrice             Float?
  purchaseStatus        PurchaseStatus?
  stripePaymentIntentId String?
  quoteData             Json?
  quoteType             LeadQuoteType     @default(CALL_VISIT)
  cancelledAt           DateTime?
  cancelledBy           String?
  cancelledReason       String?
  archivedAt            DateTime?
  assignedAt            DateTime?
  assignedBy            String?
  assignmentNotes       String?
  auditLogs             AuditLog[]
  chatMessages          ChatMessage[]
  documents             InstallDocument[]
  feedback              LeadFeedback?
  homeowner             User              @relation("homeowner_leads", fields: [homeownerId], references: [id], onDelete: Cascade)
  installer             User?             @relation("installer_leads", fields: [installerId], references: [id])
  quotes                Quote[]
  bids                  Bid[]
  assignments           LeadAssignment[]  @relation("lead_assignments")

  @@index([homeownerId])
  @@index([installerId])
  @@index([status])
  @@index([visibility])
  @@index([quoteType])
  @@index([postcode])
  @@index([state])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("leads")
}

model LeadAssignment {
  id          String   @id @default(cuid())
  leadId      String
  installerId String
  assignedBy  String
  assignedAt  DateTime @default(now())
  notes       String?
  notified    Boolean  @default(false)

  lead      Lead @relation("lead_assignments", fields: [leadId], references: [id], onDelete: Cascade)
  installer User @relation("installer_assignments", fields: [installerId], references: [id], onDelete: Cascade)
  admin     User @relation("admin_assignments", fields: [assignedBy], references: [id])

  @@unique([leadId, installerId])
  @@index([leadId])
  @@index([installerId])
  @@index([assignedBy])
  @@map("lead_assignments")
}

model PhoneVerification {
  id              String    @id @default(cuid())
  phoneNumber     String
  verificationSid String?
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  code            String
  status          String    @default("PENDING")
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([userId])
  @@index([status])
  @@map("phone_verifications")
}

model InstallDocument {
  id           String   @id @default(cuid())
  leadId       String
  documentType String
  fileName     String
  fileSize     Int
  contentType  String
  s3Key        String
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("install_documents")
}

model ChatMessage {
  id         String    @id @default(cuid())
  leadId     String
  senderId   String
  senderRole UserRole
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Quote {
  id               String    @id @default(cuid())
  leadId           String
  installerId      String
  quoteType        QuoteType
  systemSize       Float
  panelBrand       String?
  inverterBrand    String?
  batteryBrand     String?
  batteryCapacity  Float?
  totalPrice       Float
  federalRebate    Float?
  stateRebate      Float?
  finalPrice       Float
  description      String?
  paybackYears     Float?
  annualSavings    Float?
  warranty         String?
  installTimeline  String?
  attachmentS3Keys String[]
  status           String    @default("pending")
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  installer        User      @relation("installer_quotes", fields: [installerId], references: [id], onDelete: Cascade)
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([installerId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model Bid {
  id                  String    @id @default(cuid())
  leadId              String
  installerId         String
  amount              Float
  capacityOffer       Float?
  expectedInstallDate DateTime?
  notes               String?
  panelBrand          String?
  inverterBrand       String?
  batteryBrand        String?
  batteryCapacity     String?
  includeGst          Boolean   @default(true)
  gstPercent          Float     @default(10.0)
  gstAmount           Float     @default(0)
  includeIncentive    Boolean   @default(false)
  incentiveAmount     Float     @default(0)
  finalTotal          Float
  status              String    @default("SUBMITTED")
  selectedAt          DateTime?
  purchasedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Phase 13 - Comprehensive Quote Builder data (JSON fields)
  systemData       Json? // System capacity, type, solar panels array
  productsData     Json? // Panel, inverter, battery details with brands/models
  lineItems        Json? // Pricing engine 9 categories with itemized breakdown
  assumptions      Json? // Feed-in tariff, usage, offset, payback assumptions
  roofData         Json? // Roof type, pitch, arrays, orientations, shading, site details
  calculations     Json? // Total cost, GST, incentive, final total, payback calculations
  importMeta       Json? // Prefilled fields, import source, import timestamp
  installerContact Json? // Installer name, email, phone for homeowner to contact

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  installer User @relation("installer_bids", fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([leadId, installerId])
  @@index([leadId])
  @@index([installerId])
  @@index([status])
  @@index([createdAt])
  @@map("bids")
}

model LeadFeedback {
  id                    String   @id @default(cuid())
  leadId                String   @unique
  overallRating         Int
  communicationRating   Int?
  timelinessRating      Int?
  professionalismRating Int?
  comments              String?
  wouldRecommend        Boolean?
  createdAt             DateTime @default(now())
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([overallRating])
  @@map("lead_feedback")
}

model AuditLog {
  id         String   @id @default(cuid())
  leadId     String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@map("settings")
}

enum UserRole {
  GUEST
  HOMEOWNER
  INSTALLER
  ADMIN
}

enum LeadQuoteType {
  CALL_VISIT
  WRITTEN_QUOTE
  BIDDING
}

enum LeadStatus {
  DRAFT
  PENDING_PHONE
  PENDING_APPROVAL
  APPROVED
  PURCHASED
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  FLAGGED
}

enum LeadVisibility {
  HIDDEN
  PUBLIC
  PRIVATE
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_LEAD
  LEAD_PURCHASED
  LEAD_APPROVED
  LEAD_REJECTED
  NEW_QUOTE
  NEW_MESSAGE
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  PAYMENT_RECEIVED
  SYSTEM
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  LEAD_RESOLD
  ASSIGNMENT_REMOVED
  ASSIGNMENT_ACCEPTED_COMPETITIVE
  BID_WON
  BID_LOST
}

// ============================================================================
// AUTH PART A+B MODELS
// ============================================================================

model InstallerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  businessAddress   String
  postcode          String
  operationalStatus String   @default("ACTIVE") // ACTIVE | PAUSED | INACTIVE
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("installer_profiles")
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expires     DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expires])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expires     DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expires])
  @@map("password_reset_tokens")
}

// ============================================================================
// INSTALLER VERIFICATION MODELS
// ============================================================================

model InstallerVerification {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  representativeName String
  designation        String
  email              String
  phone              String
  address            String?
  abnOrLicense       String
  establishedYear    Int
  employeeCount      Int
  services           String[]
  serviceAreas       String[]
  postcodes          String[]
  website            String?
  socialLinks        Json?
  companyDescription String?
  licenseDocKey      String?
  abnDocKey          String?
  logoKey            String?
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED | MORE_INFO
  adminNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("installer_verifications")
}

model InstallerVerificationLog {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  action    String // SUBMITTED | APPROVED | REJECTED | REQUEST_INFO
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("installer_verification_logs")
}

model InstallerPreferences {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertNewLead             Boolean  @default(true)
  alertLeadUpdates         Boolean  @default(true)
  alertAdminMessages       Boolean  @default(true)
  alertVerificationUpdates Boolean  @default(true)
  alertAccountActivity     Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId])
  @@map("installer_preferences")
}

enum QuoteType {
  FORMAL
  INFORMAL
}
